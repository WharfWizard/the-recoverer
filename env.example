# Copy this file to .env for local development with `vercel dev`.
# In production, set these in the Vercel dashboard instead:
# Project → Settings → Environment Variables

ANTHROPIC_API_KEY=sk-ant-...

# Supabase project dedicated to The Recoverer (Get SAFE org, separate from
# Goliathon's project). Get these from Project Settings → API in Supabase.
# Use the service_role key, NOT the anon key — api/case.js is the only thing
# that ever sees it, and the "cases" table has RLS enabled with no policies,
# so anon/authenticated keys have zero access to it regardless.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
